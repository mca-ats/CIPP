# CIPP API credentials — copy to `.env` and fill in. NEVER commit the real .env.
# (.env / .env.* are gitignored.)

CIPP_API_URL=https://your-cipp-instance.azurewebsites.net
CIPP_TENANT_ID=00000000-0000-0000-0000-000000000000   # your CIPP/partner tenant ID (used to build the token URL)
# CIPP_TOKEN_URL=                                       # optional: full token URL; overrides CIPP_TENANT_ID
CIPP_CLIENT_ID=00000000-0000-0000-0000-000000000000    # CIPP API client (app registration) ID
CIPP_API_Secret=your-client-secret                     # CIPP API client secret

# Optional — enables the AI-written narrative. Without it the deterministic fallback is used.
# ANTHROPIC_API_KEY=sk-ant-...
